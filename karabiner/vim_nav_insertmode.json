{
    "description": "Vim Navigation (Alt+hjkl) and more in Insert Mode",
    "manipulators": [
        {
            "description": "Alt + h -> Left",
            "from": {
                "key_code": "h",
                "modifiers": {
                    "mandatory": ["left_alt"],
                    "optional": ["any"]
                }
            },
            "to": [{ "key_code": "left_arrow" }],
            "type": "basic"
        },
        {
            "description": "Alt + j -> Down",
            "from": {
                "key_code": "j",
                "modifiers": {
                    "mandatory": ["left_alt"],
                    "optional": ["any"]
                }
            },
            "to": [{ "key_code": "down_arrow" }],
            "type": "basic"
        },
        {
            "description": "Alt + k -> Up",
            "from": {
                "key_code": "k",
                "modifiers": {
                    "mandatory": ["left_alt"],
                    "optional": ["any"]
                }
            },
            "to": [{ "key_code": "up_arrow" }],
            "type": "basic"
        },
        {
            "description": "Alt + l -> Right",
            "from": {
                "key_code": "l",
                "modifiers": {
                    "mandatory": ["left_alt"],
                    "optional": ["any"]
                }
            },
            "to": [{ "key_code": "right_arrow" }],
            "type": "basic"
        },
        {
            "description": "Alt + b -> Word Left",
            "from": {
                "key_code": "b",
                "modifiers": {
                    "mandatory": ["left_alt"],
                    "optional": ["any"]
                }
            },
            "to": [
                {
                    "key_code": "left_arrow",
                    "modifiers": ["left_alt"]
                }
            ],
            "type": "basic"
        },
        {
            "description": "Alt + w -> Word Right",
            "from": {
                "key_code": "w",
                "modifiers": {
                    "mandatory": ["left_alt"],
                    "optional": ["any"]
                }
            },
            "to": [
                {
                    "key_code": "right_arrow",
                    "modifiers": ["left_alt"]
                }
            ],
            "type": "basic"
        },
        {
            "description": "Alt + u -> Home",
            "from": {
                "key_code": "u",
                "modifiers": {
                    "mandatory": ["left_alt"],
                    "optional": ["any"]
                }
            },
            "to": [{ "key_code": "home" }],
            "type": "basic"
        },
        {
            "description": "Alt + o -> End",
            "from": {
                "key_code": "o",
                "modifiers": {
                    "mandatory": ["left_alt"],
                    "optional": ["any"]
                }
            },
            "to": [{ "key_code": "end" }],
            "type": "basic"
        },
        {
            "description": "Alt + f -> Backspace",
            "from": {
                "key_code": "f",
                "modifiers": {
                    "mandatory": ["left_alt"],
                    "optional": ["any"]
                }
            },
            "to": [{ "key_code": "delete_or_backspace" }],
            "type": "basic"
        },
        {
            "description": "Alt + d -> Forward Delete",
            "from": {
                "key_code": "d",
                "modifiers": {
                    "mandatory": ["left_alt"],
                    "optional": ["any"]
                }
            },
            "to": [{ "key_code": "delete_forward" }],
            "type": "basic"
        }
    ]
}