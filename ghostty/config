theme = Gruvbox Dark

font-family = UbuntuMono Nerd Font
font-size = 20

copy-on-select = true

# 1. Đổi sang dùng Zsh làm login shell
command = /bin/zsh --login
maximize = true

# 2. ĐỔI DÒNG NÀY: Chuyển shell-integration sang zsh (hoặc để "detect")
shell-integration = zsh

# 3. ĐỔI DÒNG NÀY: Đổi Option key hỗ trợ các shortcut của Zsh
macos-option-as-alt = true

# For transparency
background-opacity = 0.88

# Cursor preferences
cursor-style = "bar"
cursor-style-blink = true
shell-integration-features = no-cursor

# Cursor shader effects (trail/boom/ripple)
custom-shader-animation = always
custom-shader = shaders/cursor_warp.glsl

# Keep titlebar visible enough to drag/move window easily.
macos-titlebar-style = "hidden"
macos-titlebar-proxy-icon = "hidden"