theme = Gruvbox Dark

font-family = UbuntuMono Nerd Font
font-size = 20

copy-on-select = true

# Zsh login shell loads ~/.zprofile and ~/.zshrc.
command = /bin/zsh --login
maximize = true

# Match shell integration to the configured shell.
shell-integration = zsh

# Option acts as Alt for shell shortcuts, including fzf's Alt+c.
macos-option-as-alt = true

# For transparency
background-opacity = 0.88

# Cursor preferences
cursor-style = "bar"
cursor-style-blink = true
shell-integration-features = no-cursor

# Cursor shader effects (trail/boom/ripple)
# Animate focused terminals only to reduce background rendering.
custom-shader-animation = true
custom-shader = effects/cursor_warp.glsl

# Keep the existing hidden titlebar and maximized-window layout.
macos-titlebar-style = "hidden"
macos-titlebar-proxy-icon = "hidden"
